FROM node:22-bookworm-slim AS node_runtime
FROM golang:1.24-bookworm AS go_runtime

FROM rust:1.93-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    git \
    golang-go \
    jq \
    nodejs \
    npm \
    python3 \
    python3-pip \
    python3-venv \
    rsync \
    strace \
    && rm -rf /var/lib/apt/lists/*

# Some corpus subjects require Node >=20. Keep Debian's npm dependencies above,
# but put the supported Node 22 runtime and npm CLI first on PATH.
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY mcp-sandboxscan/Cargo.toml mcp-sandboxscan/Cargo.toml
COPY mcp-sandboxscan/src mcp-sandboxscan/src

RUN cargo build --locked --release --bin target_egress --bin corpus \
    && cp target/release/target_egress /usr/local/bin/targeted-egress \
    && cp target/release/corpus /usr/local/bin/corpus

# strowk/mcp-k8s-go requires the Go 1.24 toolchain. Overlay it after the Rust
# build so Rust dependency layers remain cacheable when the Go version changes.
COPY --from=go_runtime /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Flux159/mcp-server-kubernetes delegates API access to kubectl. Install the
# real client so the targeted case exercises that repository's production path.
RUN apt-get update && apt-get install -y --no-install-recommends kubernetes-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/targeted-egress"]
